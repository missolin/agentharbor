{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentHarbor",
  "version": "1.2.1",
  "identifier": "local.agentharbor.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AgentHarbor · 智能体港",
        "width": 1200,
        "height": 800,
        "minWidth": 920,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
